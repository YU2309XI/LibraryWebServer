@{
    ViewData["Title"] = "Catalogue";
}

@* jQuery comes from _Layout. Loading a second copy here would discard the
   $.ajaxSetup the layout's site.js registered, and every guarded POST would
   start failing with a 400. *@

<h2>Catalogue</h2>

<div class="col-md-12">
    <table id="tblBooks" class="table table-striped">
        <thead>
            <tr>
                <th>ISBN</th>
                <th>Title</th>
                <th>Author</th>
                <th>Copy</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody id="booksBody"></tbody>
    </table>
</div>

<p>
    <a href="/Home/MyBooks">My books</a>
</p>

<button class="btn btn-secondary" onclick="LogOut()">Log out</button>

@section Scripts {
    <script type="text/javascript">
        function cell(row, text) {
            var td = document.createElement("td");
            td.appendChild(document.createTextNode(text));
            row.appendChild(td);
            return td;
        }

        function statusCell(row, item) {
            var td = document.createElement("td");

            if (!item.serial) {
                // Catalogued but no physical copy — the left join keeps the title
                // visible instead of dropping it.
                td.appendChild(document.createTextNode("no copies"));
            } else if (item.name) {
                td.appendChild(document.createTextNode(
                    "on loan to " + item.name + (item.due ? " — due " + item.due : "")));
            } else {
                var button = document.createElement("button");
                button.className = "btn btn-sm btn-primary";
                button.appendChild(document.createTextNode("Check out"));
                button.addEventListener("click", function () { CheckOut(item.serial); });
                td.appendChild(button);
            }

            row.appendChild(td);
        }

        function PopulateTable(books) {
            var body = document.getElementById("booksBody");
            body.replaceChildren();

            books.forEach(function (item) {
                var tr = document.createElement("tr");
                cell(tr, item.isbn);
                cell(tr, item.title);
                cell(tr, item.author);
                cell(tr, item.serial ? item.serial : "—");
                statusCell(tr, item);
                body.appendChild(tr);
            });
        }

        function LoadCatalogue() {
            $.ajax({
                type: "POST",
                url: '@Url.Action("AllTitles", "Home")',
                dataType: "json",
                success: PopulateTable,
                error: function () { alert("Could not load the catalogue."); }
            });
        }

        function CheckOut(serial) {
            $.ajax({
                type: "POST",
                url: '@Url.Action("CheckOutBook", "Home")',
                data: { serial: serial },
                dataType: "json",
                success: function (data) {
                    if (reportOutcome(data)) {
                        LoadCatalogue();
                    }
                },
                error: function () { alert("Checkout request failed."); }
            });
        }

        function LogOut() {
            $.ajax({
                type: "POST",
                url: '@Url.Action("LogOut", "Home")',
                dataType: "json",
                complete: function () { window.location.href = "/Home/Login"; }
            });
        }

        $(LoadCatalogue);
    </script>
}
