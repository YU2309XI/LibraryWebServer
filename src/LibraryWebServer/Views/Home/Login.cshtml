@{
    ViewData["Title"] = "Login";
}

<div class="col-md-6">
    <h2>Sign in</h2>
    <p class="text-muted">@ViewData["Message"]</p>

    <div class="mb-3">
        <label class="form-label" for="Name">Name</label>
        <input type="text" name="Name" id="Name" class="form-control" placeholder="Enter name" required />
    </div>

    <div class="mb-3">
        <label class="form-label" for="Cardnum">Card number</label>
        <input type="number" name="Cardnum" id="Cardnum" class="form-control" placeholder="Enter card number" required />
    </div>

    <button class="btn btn-primary" id="btnLogin" type="button">Sign in</button>
</div>

@section Scripts {
    <script type="text/javascript">
        $(function () {
            function submitLogin() {
                var name = $("#Name").val();
                var card = parseInt($("#Cardnum").val(), 10);

                if (!name || isNaN(card)) {
                    alert("Enter both your name and card number.");
                    return;
                }

                $.ajax({
                    type: "POST",
                    url: '@Url.Action("CheckLogin", "Home")',
                    data: { name: name, cardnum: card },
                    dataType: "json",
                    success: function (data) {
                        if (reportOutcome(data)) {
                            window.location.href = "/Home/Index";
                        }
                    },
                    error: function () { alert("Login request failed."); }
                });
            }

            $("#btnLogin").click(submitLogin);
            $("#Cardnum, #Name").on("keypress", function (e) {
                if (e.which === 13) {
                    submitLogin();
                }
            });
        });
    </script>
}
