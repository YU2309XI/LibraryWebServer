{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "SqlServer"
  },
  "LoanPolicy": {
    "LoanPeriodDays": 21,
    "MaxConcurrentLoans": 5,
    "BlockCheckoutWhenOverdue": true
  }
}
